server {
    listen 80;
    server_name _;

    # Docker embedded DNS resolver for dynamic upstream resolution.
    # Without this, nginx caches the IP of wk-node1 at startup and won't
    # pick up changes after container restarts, causing 502 errors.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # API proxy to wukongim node1
    location /route {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /user/ {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /channel/ {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /message/ {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /conversation/ {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /streammessage/ {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /conversations/ {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Uploaded files (shared volume with wk-node1)
    location = /files {
        return 301 /files/;
    }

    location /files/ {
        alias /usr/share/nginx/uploads/;
    }

    # File upload API
    location /file/ {
        set $api_upstream wk-node1:5001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 50m;
    }

    # Admin manager API
    location /manager/ {
        proxy_pass ${WK_WEB_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Chat demo (exact path without trailing slash -> redirect)
    location = /chatdemo {
        return 301 /chatdemo/;
    }

    # Chat demo
    location /chatdemo/ {
        alias /usr/share/nginx/chatdemo/;
        try_files $uri $uri/ /chatdemo/index.html;
    }

    # Prometheus proxy
    location = /prometheus {
        return 301 /prometheus/;
    }

    location /prometheus/ {
        proxy_pass http://prometheus:9090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Admin panel
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
